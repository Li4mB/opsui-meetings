PORT=8787
JWT_SECRET=change-this-secret
OPSUI_API_ORIGIN=http://localhost:1420
OPSUI_USE_SAMPLE_DATA=true
OPSUI_SEED_ADMIN_USERNAME=opsui-admin
OPSUI_SEED_ADMIN_PASSWORD=ChangeMe123!
OPSUI_SEED_ADMIN_DISPLAY_NAME=OpsUI Admin
OPSUI_DB_PROVIDER=sqlite
# For Supabase-backed production, use the Supabase Postgres connection string here and switch the provider:
# OPSUI_DB_PROVIDER=supabase
# OPSUI_DB_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?sslmode=require
OPSUI_DB_URL=
OPSUI_DB_SSL=true
OPSUI_DB_SCHEMA=opsui
OPSUI_GOOGLE_CALENDAR_ID=
OPSUI_GOOGLE_SERVICE_ACCOUNT_JSON=
OPSUI_GOOGLE_DRIVE_BRIEFS_FOLDER_ID=
# Optional override for the registered prospects sheet.
OPSUI_GOOGLE_PROSPECTS_SHEET_ID=
# Optional: comma-separated A1 ranges. Leave blank to read every tab in the prospects sheet.
OPSUI_GOOGLE_PROSPECTS_SHEET_RANGES=
OPENAI_API_KEY=
OPSUI_OPENAI_MODEL=gpt-5.2
OPSUI_OPENAI_CAPTION_MODEL=gpt-4o
OPSUI_OPENAI_IMAGE_REASONING_MODEL=gpt-5.4
OPSUI_OPENAI_IMAGE_MODEL=gpt-image-1.5
OPSUI_OPENAI_VECTOR_STORE_ID=
OPSUI_MAKE_MEETING_REQUEST_WEBHOOK_URL=
OPSUI_CALLING_WEBHOOK_URL=
OPSUI_CALLING_WEBHOOK_SECRET=
OPSUI_SOCIAL_PUBLISH_WEBHOOK_URL=
OPSUI_PUBLIC_API_URL=
OPSUI_META_GRAPH_API_VERSION=v24.0
OPSUI_LINKEDIN_API_VERSION=202601
OPSUI_FACEBOOK_PAGE_ID=
OPSUI_FACEBOOK_PAGE_ACCESS_TOKEN=
OPSUI_INSTAGRAM_USER_ID=
OPSUI_INSTAGRAM_ACCESS_TOKEN=
OPSUI_LINKEDIN_AUTHOR_URN=
OPSUI_LINKEDIN_ORGANIZATION_ID=
OPSUI_LINKEDIN_ACCESS_TOKEN=
OPSUI_X_ACCOUNT_ID=
OPSUI_X_ACCESS_TOKEN=
# X/Twitter OAuth2 app credentials (shared by all connected X accounts).
# Required for automatic access-token refresh. From the X developer portal,
# your app's "Keys and tokens" -> OAuth 2.0 Client ID and Client Secret.
OPSUI_X_CLIENT_ID=
OPSUI_X_CLIENT_SECRET=

# --- LoftAU payments ---
# Reusable Stripe Payment Links (create one per package in the Stripe dashboard).
# Each link should include the one-time setup price PLUS the $50/month recurring
# price with a 30-day free trial (first month's running on us). Paste the
# resulting https://buy.stripe.com/... URLs here.
OPSUI_LOFT_STRIPE_PAYMENT_LINK_CONNECT=
OPSUI_LOFT_STRIPE_PAYMENT_LINK_AUTOMATE=
# Make.com webhook that sends the payment-link email to the enquiry. Receives the
# booking details, chosen package and paymentUrl as JSON.
OPSUI_LOFT_PAYMENT_WEBHOOK_URL=

OPSUI_DB_PATH=
